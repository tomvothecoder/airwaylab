# AirwayLab Environment Variables
# Copy to .env.local. All optional — app works without them.
# NOTE: Supabase URL + anon key must BOTH be set (or both unset).

# Supabase (auth + data) — these two MUST be set as a pair
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry error tracking (EU region — de.sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o0.ingest.de.sentry.io/your-project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=sntrys_...

# AI Insights (requires AirwayLab sign-in; default provider is Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: personal ChatGPT plan mode, only on a server bound to 127.0.0.1.
# When enabled, set NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000 below.
# AIRWAYLAB_CHATGPT_OWNER_ID=your-supabase-user-uuid
# AIRWAYLAB_CHATGPT_MODEL=eligible-model-slug

# App URL (required for CSRF protection in production)
NEXT_PUBLIC_APP_URL=https://airwaylab.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_SUPPORTER_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_SUPPORTER_YEARLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_CHAMPION_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_CHAMPION_YEARLY_PRICE_ID=price_...

# CAN-SPAM §7704(a)(5): physical postal address of the sender — required in every commercial email footer.
# Set to AirwayLab's registered postal address. Missing = startup warning; emails send but are non-compliant.
SENDER_PHYSICAL_ADDRESS=
